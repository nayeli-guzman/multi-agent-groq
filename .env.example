# Copia este archivo como .env y pega las keys (console.groq.com → API Keys).
# Una key por integrante: el notebook las rota automáticamente si una llega a su límite.
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
# … hasta GROQ_API_KEY_9 si tienen más keys

# Solo para ensayos locales sin gastar cuota (en la demo debe quedar en groq):
# PROVEEDOR_LLM=ollama
# MODELO_OLLAMA=qwen2.5:7b
# USAR_CACHE=1
